NEXT_PUBLIC_SITE_URL=https://netasacademy.com

# Local Postgres profile
DATABASE_CLIENT=postgres
POSTGRES_PASSWORD=
DATABASE_URL=postgres://netas_academy:${POSTGRES_PASSWORD}@postgres:5432/netas_academy

# Postgres backup sidecar, used by the root docker-compose.yml.
# Copy these into the root .env file for real B2 tests.
# B2_BACKUP_BUCKET must be the bucket name, not the bucket id.
B2_BACKUP_BUCKET=
B2_BACKUP_APPLICATION_KEY_ID=
B2_BACKUP_APPLICATION_KEY=
B2_BACKUP_PREFIX=postgres
BACKUP_CRON_SCHEDULE=0 2 * * *
BACKUP_RUN_ON_START=true
