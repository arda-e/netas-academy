NEXT_PUBLIC_SITE_URL=https://netasacademy.com
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Local Postgres profile and production-compatible defaults
DATABASE_CLIENT=postgres
POSTGRES_PASSWORD=
DATABASE_URL=postgres://netas_academy:${POSTGRES_PASSWORD}@postgres:5432/netas_academy

# GitLab Ubuntu production deploy variables. Set real values as protected
# GitLab CI/CD variables or in the server-local .env file, not in Git.
PRODUCTION_HOST=185.48.181.248
PRODUCTION_USER=root
PRODUCTION_APP_DIR=/opt/netas_academy
REGISTRY_DEPLOY_USER=
REGISTRY_DEPLOY_PASSWORD=
APP_KEYS=
ADMIN_JWT_SECRET=
API_TOKEN_SALT=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=
JWT_SECRET=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
PREVIEW_SECRET=

# Postgres backup sidecar, used by the root docker-compose.yml.
# Copy these into the root .env file for real B2 tests.
# B2_BACKUP_BUCKET must be the bucket name, not the bucket id.
B2_BACKUP_BUCKET=
B2_BACKUP_APPLICATION_KEY_ID=
B2_BACKUP_APPLICATION_KEY=
B2_BACKUP_PREFIX=postgres
BACKUP_CRON_SCHEDULE=0 2 * * *
BACKUP_RUN_ON_START=true
